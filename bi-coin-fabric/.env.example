PORT=8080
FABRIC_MSP_ID=CentralBankMSP
# Paths are relative to backend/ because the server is started there.
FABRIC_CERT_PATH=../network/organizations/peerOrganizations/bi-coin/users/Admin@bi-coin/msp/signcerts/Admin@bi-coin-cert.pem
FABRIC_KEY_PATH=../network/organizations/peerOrganizations/bi-coin/users/Admin@bi-coin/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=../network/organizations/peerOrganizations/bi-coin/peers/peer0.bi-coin/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_PEER=peer0.bi-coin
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=digital-rupiah
CONTRACT_SCHEMA_VERSION=v3
FABRIC_GATEWAYS_JSON=[{"msp_id":"CentralBankMSP","peer_endpoint":"localhost:7051","cert_path":"../network/organizations/peerOrganizations/bi-coin/users/Admin@bi-coin/msp/signcerts/Admin@bi-coin-cert.pem","key_path":"../network/organizations/peerOrganizations/bi-coin/users/Admin@bi-coin/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/bi-coin/peers/peer0.bi-coin/tls/ca.crt"},{"msp_id":"DistributorMSP","peer_endpoint":"localhost:9051","cert_path":"../network/organizations/peerOrganizations/distributor.bi-coin/users/Admin@distributor.bi-coin/msp/signcerts/Admin@distributor.bi-coin-cert.pem","key_path":"../network/organizations/peerOrganizations/distributor.bi-coin/users/Admin@distributor.bi-coin/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/distributor.bi-coin/peers/peer0.distributor.bi-coin/tls/ca.crt"},{"msp_id":"ValidatorMSP","peer_endpoint":"localhost:12051","cert_path":"../network/organizations/peerOrganizations/validator.bi-coin/users/Admin@validator.bi-coin/msp/signcerts/Admin@validator.bi-coin-cert.pem","key_path":"../network/organizations/peerOrganizations/validator.bi-coin/users/Admin@validator.bi-coin/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/validator.bi-coin/peers/peer0.validator.bi-coin/tls/ca.crt"},{"msp_id":"EndUserMSP","peer_endpoint":"localhost:13051","cert_path":"../network/organizations/peerOrganizations/enduser.bi-coin/users/Admin@enduser.bi-coin/msp/signcerts/Admin@enduser.bi-coin-cert.pem","key_path":"../network/organizations/peerOrganizations/enduser.bi-coin/users/Admin@enduser.bi-coin/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/enduser.bi-coin/peers/peer0.enduser.bi-coin/tls/ca.crt"}]

# PostgreSQL off-chain KYC and auth store.
DATABASE_URL=postgres://bicoin:bicoin@localhost:5433/bicoin?sslmode=disable

# JWT auth. Override secrets outside local PoC.
AUTH_JWT_SECRET=dev-auth-secret-change-me
AUTH_TOKEN_TTL_SECONDS=3600

# Demo users are bootstrapped on backend startup.
# Roles: authenticated, kyc_verified, pjp, bank_pjp (legacy alias), bank_indonesia, merchant, supervisor.
AUTH_BOOTSTRAP_USERS_JSON=[{"username":"bi","password":"bi-password","role":"bank_indonesia"},{"username":"pjp","password":"pjp-password","role":"pjp","participant_id":"gopay","custodian_msp_id":"PJPOrgMSP"},{"username":"merchant","password":"merchant-password","role":"merchant"},{"username":"supervisor","password":"supervisor-password","role":"supervisor"},{"username":"customer","password":"customer-password","role":"kyc_verified"}]


# HMAC key for document hashes anchored on Fabric.
KYC_HASH_SECRET=dev-kyc-hash-secret-change-me
