PORT=8080
FABRIC_MSP_ID=BankIndonesiaOrgMSP
# Paths are relative to backend/ because the server is started there.
FABRIC_CERT_PATH=../network/organizations/peerOrganizations/bi.paynet/users/Admin@bi.paynet/msp/signcerts/Admin@bi.paynet-cert.pem
FABRIC_KEY_PATH=../network/organizations/peerOrganizations/bi.paynet/users/Admin@bi.paynet/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=../network/organizations/peerOrganizations/bi.paynet/peers/peer0.bi.paynet/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_PEER=peer0.bi.paynet
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=digital-rupiah
CONTRACT_SCHEMA_VERSION=v3
FABRIC_GATEWAYS_JSON=[{"msp_id":"BankIndonesiaOrgMSP","peer_endpoint":"localhost:7051","cert_path":"../network/organizations/peerOrganizations/bi.paynet/users/Admin@bi.paynet/msp/signcerts/Admin@bi.paynet-cert.pem","key_path":"../network/organizations/peerOrganizations/bi.paynet/users/Admin@bi.paynet/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/bi.paynet/peers/peer0.bi.paynet/tls/ca.crt"},{"msp_id":"HimbaraBankOrgMSP","peer_endpoint":"localhost:9051","cert_path":"../network/organizations/peerOrganizations/himbara.paynet/users/Admin@himbara.paynet/msp/signcerts/Admin@himbara.paynet-cert.pem","key_path":"../network/organizations/peerOrganizations/himbara.paynet/users/Admin@himbara.paynet/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/himbara.paynet/peers/peer0.himbara.paynet/tls/ca.crt"},{"msp_id":"CommercialBankOrgMSP","peer_endpoint":"localhost:11051","cert_path":"../network/organizations/peerOrganizations/commercial.paynet/users/Admin@commercial.paynet/msp/signcerts/Admin@commercial.paynet-cert.pem","key_path":"../network/organizations/peerOrganizations/commercial.paynet/users/Admin@commercial.paynet/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/commercial.paynet/peers/peer0.commercial.paynet/tls/ca.crt"},{"msp_id":"OJKObserverOrgMSP","peer_endpoint":"localhost:12051","cert_path":"../network/organizations/peerOrganizations/ojk.paynet/users/Admin@ojk.paynet/msp/signcerts/Admin@ojk.paynet-cert.pem","key_path":"../network/organizations/peerOrganizations/ojk.paynet/users/Admin@ojk.paynet/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/ojk.paynet/peers/peer0.ojk.paynet/tls/ca.crt"},{"msp_id":"PJPOrgMSP","peer_endpoint":"localhost:13051","cert_path":"../network/organizations/peerOrganizations/pjp.paynet/users/Admin@pjp.paynet/msp/signcerts/Admin@pjp.paynet-cert.pem","key_path":"../network/organizations/peerOrganizations/pjp.paynet/users/Admin@pjp.paynet/msp/keystore/priv_sk","tls_cert_path":"../network/organizations/peerOrganizations/pjp.paynet/peers/peer0.pjp.paynet/tls/ca.crt"}]

# PostgreSQL off-chain KYC and auth store.
DATABASE_URL=postgres://bicoin:bicoin@localhost:5433/bicoin?sslmode=disable

# JWT auth. Override secrets outside local PoC.
AUTH_JWT_SECRET=dev-auth-secret-change-me
AUTH_TOKEN_TTL_SECONDS=3600

# Demo users are bootstrapped on backend startup.
# Roles: authenticated, kyc_verified, validator_bank, pjp, bank_pjp (legacy alias), bank_indonesia, merchant, supervisor.
AUTH_BOOTSTRAP_USERS_JSON=[{"username":"bi","password":"bi-password","role":"bank_indonesia"},{"username":"validator","password":"validator-password","role":"validator_bank","participant_id":"himbara","custodian_msp_id":"HimbaraBankOrgMSP"},{"username":"pjp","password":"pjp-password","role":"pjp","participant_id":"gopay","custodian_msp_id":"PJPOrgMSP"},{"username":"merchant","password":"merchant-password","role":"merchant"},{"username":"supervisor","password":"supervisor-password","role":"supervisor"},{"username":"customer","password":"customer-password","role":"kyc_verified"}]


# HMAC key for document hashes anchored on Fabric.
KYC_HASH_SECRET=dev-kyc-hash-secret-change-me
