PORT=8080
CONTRACT_SCHEMA_VERSION=v3

# PostgreSQL off-chain KYC and auth store.
DATABASE_URL=postgres://bicoin:bicoin@localhost:5433/bicoin?sslmode=disable

# JWT auth. Override secrets outside local PoC.
AUTH_JWT_SECRET=dev-auth-secret-change-me
AUTH_TOKEN_TTL_SECONDS=3600

# Demo users are bootstrapped on backend startup.
# Roles: authenticated, kyc_verified, retail_bank, wholesale_bank, bank_indonesia, merchant, auditor.
AUTH_BOOTSTRAP_USERS_JSON=[{"username":"bi","password":"bi-password","role":"bank_indonesia"},{"username":"retail-bank","password":"retail-bank-password","role":"retail_bank","participant_id":"retail-bank","custodian_msp_id":"DistributorMSP"},{"username":"wholesale-bank","password":"wholesale-bank-password","role":"wholesale_bank","participant_id":"wholesale-bank"},{"username":"wholesale-bank-2","password":"wholesale-bank-2-password","role":"wholesale_bank","participant_id":"wholesale-bank"},{"username":"merchant","password":"merchant-password","role":"merchant"},{"username":"auditor","password":"auditor-password","role":"auditor"},{"username":"customer","password":"customer-password","role":"kyc_verified"}]

# Study Fabric identities for the bank, Bank Indonesia, and auditor routes. Each username signs with one organization certificate.
FABRIC_IDENTITIES_JSON=[{"username":"retail-bank","msp_id":"DistributorMSP","peer_endpoint":"localhost:18051","gateway_peer":"peer0.distributor.bi-coin:7051","cert_path":"/absolute/path/to/User1@distributor.bi-coin/msp/signcerts/cert.pem","key_path":"/absolute/path/to/User1@distributor.bi-coin/msp/keystore/priv_sk","tls_cert_path":"/absolute/path/to/peer0.distributor.bi-coin/tls/ca.crt"},{"username":"wholesale-bank","msp_id":"DistributorMSP","peer_endpoint":"localhost:18051","gateway_peer":"peer0.distributor.bi-coin:7051","cert_path":"/absolute/path/to/User4@distributor.bi-coin/msp/signcerts/cert.pem","key_path":"/absolute/path/to/User4@distributor.bi-coin/msp/keystore/priv_sk","tls_cert_path":"/absolute/path/to/peer0.distributor.bi-coin/tls/ca.crt"},{"username":"wholesale-bank-2","msp_id":"DistributorMSP","peer_endpoint":"localhost:18051","gateway_peer":"peer0.distributor.bi-coin:7051","cert_path":"/absolute/path/to/User5@distributor.bi-coin/msp/signcerts/cert.pem","key_path":"/absolute/path/to/User5@distributor.bi-coin/msp/keystore/priv_sk","tls_cert_path":"/absolute/path/to/peer0.distributor.bi-coin/tls/ca.crt"},{"username":"bi","msp_id":"CentralBankMSP","peer_endpoint":"localhost:17051","gateway_peer":"peer0.centralbank.bi-coin:7051","cert_path":"/absolute/path/to/Admin@centralbank.bi-coin/msp/signcerts/cert.pem","key_path":"/absolute/path/to/Admin@centralbank.bi-coin/msp/keystore/priv_sk","tls_cert_path":"/absolute/path/to/peer0.centralbank.bi-coin/tls/ca.crt"},{"username":"auditor","msp_id":"ValidatorMSP","peer_endpoint":"localhost:19051","gateway_peer":"peer0.validator.bi-coin:7051","cert_path":"/absolute/path/to/Admin@validator.bi-coin/msp/signcerts/cert.pem","key_path":"/absolute/path/to/Admin@validator.bi-coin/msp/keystore/priv_sk","tls_cert_path":"/absolute/path/to/peer0.validator.bi-coin/tls/ca.crt"}]


