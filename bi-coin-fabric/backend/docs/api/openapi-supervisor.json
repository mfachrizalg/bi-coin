        "summary": "Get KYC/KYB profile",
        "description": "Returns one KYC/KYB profile without raw documents.",
        "operationId": "get_kyc_profile_kyc_profiles__profile_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "profile_id",
            "in": "path",
