{
  "openapi": "3.1.0",
  "info": {
    "title": "Garuda Digital Rupiah API Gateway — Role: multi",
    "description": "Filtered API spec for thesis role: **supervisor**.\n\nIncluded OpenAPI tag groups: ['kyc', 'limits', 'network', 'privacy', 'supervision']\n\nThis embedded role-filtered API spec is maintained with the backend role surface.",
    "version": "0.1.0"
  },
  "paths": {
    "/network/topology": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Get logical Indonesia CBDC topology",
        "description": "Returns the thesis/prototype logical node map. Observer, policy, security, and API nodes are visible here but do not vote in Sumeragi consensus. Retail users and merchants access the ledger through participant APIs, not as ledger nodes.",
        "operationId": "network_topology_network_topology_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/retail/customers": {
      "get": {
        "tags": [
          "kyc"
        ],
        "summary": "List retail customer identity bindings",
        "description": "Returns retail customer shells without raw identity documents.",
        "operationId": "list_retail_customers_retail_customers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/kyc/profiles/{profile_id}": {
