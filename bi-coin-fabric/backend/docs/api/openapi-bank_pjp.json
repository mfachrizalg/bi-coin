          "value": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Value",
            "description": "Maximum value for the given scope.",
            "examples": [
              "1000000"
            ]
          }
        },
        "type": "object",
        "required": [
          "scope",
          "value"
        ],
        "title": "SetLimitRequestBody",
        "example": {
          "scope": "global_supply",
          "value": "1000000"
        }
      },
      "TransferRequestBody": {
        "properties": {
          "sender_id": {
            "type": "string",
            "minLength": 1,
