    "/issuance-requests": {
      "post": {
        "tags": [
          "liquidity"
        ],
        "summary": "Request wholesale Digital Rupiah issuance",
        "description": "Debits the participant mock RTGS reserve first, then mints wholesale Rupiah Digital to the participant ledger account.",
        "operationId": "issuance_request_issuance_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AmountRequestBody"
              },
              "examples": {
                "mint_bank_a": {
                  "summary": "Issue 250 to Bank A",
                  "description": "Run after Bank A is approved. Requires X-API-Key: dev-participant-key.",
                  "value": {
                    "participant_id": "bank-a",
                    "amount": "250"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AmountRequestBody": {
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id",
            "description": "Participant requesting issuance or redemption.",
            "examples": [
              "bank-a"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount",
            "description": "Wholesale Rupiah Digital amount represented as a decimal string.",
            "examples": [
              "100"
            ]
          }
        },
        "type": "object",
        "required": [
          "participant_id",
          "amount"
        ],
        "title": "AmountRequestBody",
        "example": {
          "amount": "100",
          "participant_id": "bank-a"
        }
      },
      "CreateWalletRequestBody": {
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id",
            "description": "Participant who owns the wallet.",
            "examples": [
              "bank-a"
            ]
          },
          "wallet_type": {
            "$ref": "#/components/schemas/WalletType",
            "description": "Hot wallet (online) or cold wallet.",
            "default": "hot",
            "examples": [
              "hot"
            ]
          }
        },
        "type": "object",
        "required": [
          "participant_id"
        ],
        "title": "CreateWalletRequestBody",
        "example": {
          "participant_id": "bank-a",
          "wallet_type": "hot"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KycProfileRequestBody": {
        "properties": {
          "subject_type": {
            "$ref": "#/components/schemas/KycSubjectType",
            "description": "Entity being verified: participant institution, retail customer, or merchant.",
            "examples": [
              "retail_customer",
              "merchant"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "title": "Subject Id",
            "description": "Subject identifier.",
            "examples": [
              "bank-a"
            ]
          },
          "provider_case_id": {
            "type": "string",
            "minLength": 1,
            "title": "Provider Case Id",
            "description": "External KYC/KYB provider case reference.",
            "examples": [
              "sumsub-case-bank-a"
            ]
          },
          "document_hashes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Document Hashes",
            "description": "Opaque document hashes only. Raw identity documents are not stored.",
            "examples": [
              [
                "sha256:document-hash"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "subject_type",
          "subject_id",
          "provider_case_id",
          "document_hashes"
        ],
        "title": "KycProfileRequestBody",
        "example": {
          "document_hashes": [
            "sha256:document-hash"
          ],
          "provider_case_id": "sumsub-case-bank-a",
          "subject_id": "bank-a",
          "subject_type": "participant"
        }
      },
      "KycProviderResultRequestBody": {
        "properties": {
          "provider_case_id": {
            "type": "string",
            "minLength": 1,
            "title": "Provider Case Id",
            "description": "Provider case reference."
          },
          "status": {
            "$ref": "#/components/schemas/KycStatus",
            "description": "Provider decision status."
          },
          "risk_level": {
            "$ref": "#/components/schemas/KycRiskLevel",
            "description": "Provider risk classification."
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks",
            "description": "Provider check names and normalized outcomes."
          },
          "document_hashes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Document Hashes",
            "description": "Opaque hashes for documents used by the provider."
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejection Reason",
            "description": "Reason for rejection."
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "KYC expiry timestamp."
          },
          "due_diligence_level": {
            "$ref": "#/components/schemas/DueDiligenceLevel"
          },
          "senior_approval": {
            "type": "boolean",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "provider_case_id",
          "status",
          "risk_level",
          "document_hashes",
          "due_diligence_level",
          "senior_approval"
        ],
        "title": "KycProviderResultRequestBody",
        "example": {
          "checks": {
            "adverse_media": "clear",
            "identity_or_business_verification": "pass",
            "pep": "clear",
            "sanctions": "clear"
          },
          "document_hashes": [
            "sha256:document-hash"
          ],
          "provider_case_id": "sumsub-case-bank-a",
          "risk_level": "low",
          "status": "approved"
        }
      },
      "KycRiskLevel": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "prohibited"
        ],
        "title": "KycRiskLevel"
      },
