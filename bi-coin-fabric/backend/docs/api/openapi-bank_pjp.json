{
  "openapi": "3.1.0",
  "info": {
    "title": "Garuda Digital Rupiah API Gateway — Role: multi",
    "description": "Filtered API spec for thesis role: **bank_pjp**.\n\nIncluded OpenAPI tag groups: ['kyc', 'liquidity', 'participants', 'wallets']\n\nThis embedded role-filtered API spec is maintained with the backend role surface.",
    "version": "0.1.0"
  },
  "paths": {
    "/participants": {
      "post": {
        "tags": [
          "participants"
        ],
        "summary": "Submit participant onboarding request",
        "description": "Creates a pending institutional participant with a mock RTGS reserve account. Use this first in demos before BI approval, KYC/KYB approval, issuance, wallet distribution, and retail payment flows.",
        "operationId": "submit_participant_participants_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingRequestBody"
              },
              "examples": {
                "validator_bank": {
                  "summary": "Validator participant with RTGS liquidity",
                  "description": "Use this to onboard a Himbara bank validator participant.",
                  "value": {
                    "participant_id": "bank-himbara-validator",
                    "name": "Himbara Disbursement Bank",
                    "domain": "bank-himbara.paynet",
                    "account_id": "bank-himbara-account",
                    "participant_type": "validator",
                    "initial_reserve_balance": "1000",
                    "compliance_status": "active"
                  }
                },
                "receiver_bank": {
                  "summary": "Receiver participant",
                  "description": "Use this to onboard a commercial bank for transfer demonstrations.",
                  "value": {
                    "participant_id": "bank-commercial-validator",
                    "name": "Systemic Commercial Bank",
                    "domain": "bank-commercial.paynet",
                    "account_id": "bank-commercial-account",
                    "participant_type": "validator",
                    "initial_reserve_balance": "500",
                    "compliance_status": "active"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
