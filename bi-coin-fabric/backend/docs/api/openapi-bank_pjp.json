      "RegisterTriggerRequestBody": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name",
            "description": "Trigger name.",
            "examples": [
              "tax_withholding"
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable description.",
            "default": "",
            "examples": [
              "Auto tax withholding"
            ]
          },
          "action_type": {
            "type": "string",
            "minLength": 1,
            "title": "Action Type",
            "description": "Trigger event: on_transfer, on_issuance, on_redemption, periodic.",
            "examples": [
              "on_transfer"
            ]
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "Arbitrary key-value parameters for the trigger logic."
          }
        },
        "type": "object",
        "required": [
          "name",
          "action_type"
        ],
        "title": "RegisterTriggerRequestBody",
        "example": {
          "action_type": "on_transfer",
          "description": "Automatically withhold tax on transfers above threshold",
          "name": "tax_withholding",
          "params": {
            "rate": "0.10",
            "threshold": "10000"
          }
        }
      },
      "RetailCustomerRequestBody": {
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "title": "Customer Id",
            "description": "Internal retail customer identifier.",
            "examples": [
              "cust-001"
            ]
          },
          "legal_name": {
            "type": "string",
            "minLength": 1,
            "title": "Legal Name",
