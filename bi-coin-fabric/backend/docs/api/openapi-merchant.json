{
  "openapi": "3.1.0",
  "info": {
    "title": "Garuda Digital Rupiah API Gateway — Role: merchant",
    "description": "Filtered API spec for thesis role: **merchant**.\n\nIncluded OpenAPI tag groups: []\n\nThis embedded role-filtered API spec is maintained with the backend role surface.",
    "version": "0.1.0"
  },
  "paths": {
    "/wallets": {
      "get": {
        "tags": [
          "wallets"
        ],
        "summary": "List wallets",
        "description": "Returns wallets, optionally filtered by participant.",
        "operationId": "list_wallets_wallets_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "participant_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Participant Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transfers": {
      "post": {
        "tags": [
          "liquidity"
        ],
        "summary": "Submit wholesale transfer",
        "description": "Transfers wholesale Rupiah Digital between active participants. ",
        "operationId": "transfer_request_transfers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequestBody"
              },
              "examples": {
                "successful_transfer": {
                  "summary": "Bank A pays Bank B",
                  "description": "Run after both banks are approved and Bank A has issued balance.",
                  "value": {
                    "sender_id": "bank-a",
                    "receiver_id": "bank-b",
                    "amount": "75"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/balances": {
      "get": {
        "tags": [
          "liquidity"
        ],
        "summary": "List participant Digital Rupiah balances",
        "description": "Returns simulated wholesale Rupiah Digital balances by participant id.",
        "operationId": "balances_balances_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/redemption-requests": {
      "post": {
        "tags": [
          "liquidity"
        ],
        "summary": "Request wholesale Digital Rupiah redemption",
        "description": "Burns the participant ledger balance first, then credits the mock RTGS reserve account.",
        "operationId": "redemption_request_redemption_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AmountRequestBody"
              },
              "examples": {
                "redeem_bank_a": {
                  "summary": "Redeem 50 from Bank A",
                  "description": "Run after Bank A has issued balance.",
                  "value": {
                    "participant_id": "bank-a",
                    "amount": "50"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AmountRequestBody": {
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id",
            "description": "Participant requesting issuance or redemption.",
            "examples": [
              "bank-a"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount",
            "description": "Wholesale Rupiah Digital amount represented as a decimal string.",
            "examples": [
              "100"
            ]
          }
        },
        "type": "object",
        "required": [
          "participant_id",
          "amount"
        ],
        "title": "AmountRequestBody",
        "example": {
          "amount": "100",
          "participant_id": "bank-a"
        }
      },
      "CreateWalletRequestBody": {
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id",
            "description": "Participant who owns the wallet.",
            "examples": [
              "bank-a"
            ]
          },
          "wallet_type": {
            "$ref": "#/components/schemas/WalletType",
            "description": "Hot wallet (online) or cold wallet.",
            "default": "hot",
            "examples": [
              "hot"
            ]
          }
        },
        "type": "object",
        "required": [
          "participant_id"
        ],
        "title": "CreateWalletRequestBody",
        "example": {
          "participant_id": "bank-a",
          "wallet_type": "hot"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KycProfileRequestBody": {
        "properties": {
          "subject_type": {
            "$ref": "#/components/schemas/KycSubjectType",
            "description": "Entity being verified: participant institution, retail customer, or merchant.",
            "examples": [
              "retail_customer",
              "merchant"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "title": "Subject Id",
            "description": "Subject identifier.",
            "examples": [
              "bank-a"
            ]
          },
          "provider_case_id": {
            "type": "string",
            "minLength": 1,
            "title": "Provider Case Id",
            "description": "External KYC/KYB provider case reference.",
            "examples": [
              "sumsub-case-bank-a"
            ]
          },
          "document_hashes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Document Hashes",
            "description": "Opaque document hashes only. Raw identity documents are not stored.",
            "examples": [
              [
                "sha256:document-hash"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "subject_type",
          "subject_id",
          "provider_case_id",
          "document_hashes"
        ],
        "title": "KycProfileRequestBody",
        "example": {
          "document_hashes": [
            "sha256:document-hash"
          ],
          "provider_case_id": "sumsub-case-bank-a",
          "subject_id": "bank-a",
          "subject_type": "participant"
        }
      },
      "KycProviderResultRequestBody": {
        "properties": {
          "provider_case_id": {
            "type": "string",
            "minLength": 1,
            "title": "Provider Case Id",
            "description": "Provider case reference."
          },
          "status": {
            "$ref": "#/components/schemas/KycStatus",
            "description": "Provider decision status."
          },
          "risk_level": {
            "$ref": "#/components/schemas/KycRiskLevel",
            "description": "Provider risk classification."
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks",
            "description": "Provider check names and normalized outcomes."
          },
          "document_hashes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Document Hashes",
            "description": "Opaque hashes for documents used by the provider."
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejection Reason",
            "description": "Reason for rejection."
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "KYC expiry timestamp."
          },
          "due_diligence_level": {
            "$ref": "#/components/schemas/DueDiligenceLevel"
          },
          "senior_approval": {
            "type": "boolean",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "provider_case_id",
          "status",
          "risk_level",
          "document_hashes",
          "due_diligence_level",
          "senior_approval"
        ],
        "title": "KycProviderResultRequestBody",
        "example": {
          "checks": {
            "adverse_media": "clear",
            "identity_or_business_verification": "pass",
            "pep": "clear",
            "sanctions": "clear"
          },
          "document_hashes": [
            "sha256:document-hash"
          ],
          "provider_case_id": "sumsub-case-bank-a",
          "risk_level": "low",
          "status": "approved"
        }
      },
      "KycRiskLevel": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "prohibited"
        ],
        "title": "KycRiskLevel"
      },
      "KycStatus": {
        "type": "string",
        "enum": [
          "pending",
          "in_review",
          "approved",
          "rejected",
          "expired",
          "suspended"
        ],
        "title": "KycStatus"
      },
      "KycSubjectType": {
        "type": "string",
        "enum": [
          "participant",
          "retail_customer",
          "merchant"
        ],
        "title": "KycSubjectType"
      },
      "LimitScope": {
        "type": "string",
        "enum": [
          "global_supply",
          "per_participant_balance",
          "per_tx_amount"
        ],
        "title": "LimitScope"
      },
      "OnboardingRequestBody": {
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Participant Id",
            "description": "Unique participant code used by BI supervision and payment workflows.",
            "examples": [
              "bank-a"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name",
            "description": "Legal or demo display name for the participating institution.",
            "examples": [
              "Bank A Demo"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "title": "Domain",
            "description": "Iroha domain namespace assigned to the participant.",
            "examples": [
              "bank-a.paynet"
            ]
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "title": "Account Id",
            "description": "Iroha account that will hold wholesale Rupiah Digital balances.",
            "examples": [
              "bank-a-account"
            ]
          },
          "participant_type": {
            "$ref": "#/components/schemas/ParticipantType",
            "description": "Participant category in the wholesale Digital Rupiah network.",
            "examples": [
              "validator"
            ]
          },
          "initial_reserve_balance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Initial Reserve Balance",
            "description": "Mock BI-RTGS reserve balance available for future issuance requests.",
            "default": "0",
            "examples": [
              "1000"
            ]
          },
          "compliance_status": {
            "type": "string",
            "title": "Compliance Status",
            "description": "Legacy demo field. KYC approval is enforced through KYC profile endpoints.",
            "default": "active",
            "examples": [
              "active"
            ]
          }
        },
        "type": "object",
        "required": [
          "participant_id",
          "name",
          "domain",
          "account_id",
          "participant_type"
        ],
        "title": "OnboardingRequestBody",
        "example": {
          "account_id": "bank-a-account",
          "compliance_status": "active",
          "domain": "bank-a.paynet",
          "initial_reserve_balance": "1000",
          "name": "Bank A Demo",
          "participant_id": "bank-a",
          "participant_type": "validator"
        }
      },
      "ParticipantType": {
        "type": "string",
        "enum": [
          "validator",
          "non_validator",
          "no_node"
        ],
        "title": "ParticipantType"
      },
      "RegisterTriggerRequestBody": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name",
            "description": "Trigger name.",
            "examples": [
              "tax_withholding"
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable description.",
            "default": "",
            "examples": [
              "Auto tax withholding"
            ]
          },
          "action_type": {
            "type": "string",
            "minLength": 1,
            "title": "Action Type",
            "description": "Trigger event: on_transfer, on_issuance, on_redemption, periodic.",
            "examples": [
              "on_transfer"
            ]
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "Arbitrary key-value parameters for the trigger logic."
          }
        },
        "type": "object",
        "required": [
          "name",
          "action_type"
        ],
        "title": "RegisterTriggerRequestBody",
        "example": {
          "action_type": "on_transfer",
          "description": "Automatically withhold tax on transfers above threshold",
          "name": "tax_withholding",
          "params": {
            "rate": "0.10",
            "threshold": "10000"
          }
        }
      },
      "RetailCustomerRequestBody": {
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "title": "Customer Id",
            "description": "Internal retail customer identifier.",
            "examples": [
              "cust-001"
            ]
          },
          "legal_name": {
            "type": "string",
            "minLength": 1,
            "title": "Legal Name",
            "description": "Legal name kept in the participant provider system.",
            "examples": [
              "Retail Customer 001"
            ]
          },
          "wallet_account_id": {
            "type": "string",
            "minLength": 1,
            "title": "Wallet Account Id",
            "description": "Ledger wallet account bound to this retail customer.",
            "examples": [
              "cust-001-wallet"
            ]
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "legal_name",
          "wallet_account_id"
        ],
        "title": "RetailCustomerRequestBody",
        "example": {
          "customer_id": "cust-001",
          "legal_name": "Retail Customer 001",
          "wallet_account_id": "cust-001-wallet"
        }
      },
      "SetLimitRequestBody": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/LimitScope",
            "description": "Limit scope: global_supply, per_participant_balance, or per_tx_amount."
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Value",
            "description": "Maximum value for the given scope.",
            "examples": [
              "1000000"
            ]
          }
        },
        "type": "object",
        "required": [
          "scope",
          "value"
        ],
        "title": "SetLimitRequestBody",
        "example": {
          "scope": "global_supply",
          "value": "1000000"
        }
      },
      "TransferRequestBody": {
        "properties": {
          "sender_id": {
            "type": "string",
            "minLength": 1,
            "title": "Sender Id",
            "description": "Participant whose Rupiah Digital balance will be debited.",
            "examples": [
              "bank-a"
            ]
          },
          "receiver_id": {
            "type": "string",
            "minLength": 1,
            "title": "Receiver Id",
            "description": "Participant whose Rupiah Digital balance will be credited.",
            "examples": [
              "bank-b"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount",
            "description": "Wholesale transfer amount. ",
            "examples": [
              "75"
            ]
          }
        },
        "type": "object",
        "required": [
          "sender_id",
          "receiver_id",
          "amount"
        ],
        "title": "TransferRequestBody",
        "example": {
          "amount": "75",
          "receiver_id": "bank-b",
          "sender_id": "bank-a"
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WalletType": {
        "type": "string",
        "enum": [
          "hot",
          "cold"
        ],
        "title": "WalletType"
      },
      "DueDiligenceLevel": {
        "type": "string",
        "enum": [
          "simplified",
          "standard",
          "enhanced"
        ]
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "tags": []
}
