    {"chaincode": "rupiah-controls", "method": "CanActFor", "cases": ["individual owner", "merchant owner", "business representative", "unlisted representative", "replaced representative"]},
    {"chaincode": "rupiah-controls", "method": "GetSubject", "cases": ["CentralBank read", "Distributor read", "Validator read", "EndUser denied; observe response-schema error"]},
    {"chaincode": "rupiah-monetary", "method": "Initialize", "cases": ["initialize empty ledger", "repeat initialization"]},
    {"chaincode": "rupiah-monetary", "method": "RegisterDistributor", "cases": ["register wholesale bank", "register retail bank", "duplicate distributor", "wrong MSP"]},
    {"chaincode": "rupiah-monetary", "method": "Issue", "cases": ["positive issuance", "nonpositive amount", "reference replay", "reference payload conflict", "insufficient endorsement"]},
    {"chaincode": "rupiah-monetary", "method": "RedeemReserve", "cases": ["redeem reserve and supply equally", "nonpositive amount", "insufficient reserve", "reference replay", "reference payload conflict", "wrong MSP"]},
    {"chaincode": "rupiah-monetary", "method": "TransferReserve", "cases": ["wholesale to retail transfer", "cross-bank debit denied", "nonpositive amount", "insufficient reserve", "reference replay", "wrong MSP"]},
    {"chaincode": "rupiah-monetary", "method": "DebitReserveForConversion", "cases": ["nested call from ConvertToRetail", "direct invocation denied", "unauthorized MSP"]},
    {"chaincode": "rupiah-monetary", "method": "GetWholesaleSupply", "cases": ["supply after issuance", "supply after conversion"]},
    {"chaincode": "rupiah-monetary", "method": "GetRetailSupply", "cases": ["supply after conversion"]},
    {"chaincode": "rupiah-monetary", "method": "GetTotalSupply", "cases": ["supply increases on issuance", "supply conserved on transfer and conversion", "supply decreases on redemption", "total equals wholesale plus retail"]},
    {"chaincode": "rupiah-monetary", "method": "GetReserve", "cases": ["issuance credit", "interbank transfer debit", "conversion debit", "redemption debit"]},
    {"chaincode": "rupiah-payments", "method": "OpenWallet", "cases": ["open eligible wallet", "duplicate wallet", "ineligible subject", "unauthorized owner", "insufficient endorsement"]},
    {"chaincode": "rupiah-payments", "method": "Transfer", "cases": ["all nine sender and recipient category pairs", "per-transaction limit exact and one-unit excess", "daily limit exact and one-unit excess", "monthly limit exact and one-unit excess", "recipient holdings exact and one-unit excess", "insufficient balance", "restricted sender", "restricted recipient", "unauthorized business representative", "UTC day and month rollover", "concurrent shared-balance conflict", "same-reference replay", "same-reference payload conflict"]},
    {"chaincode": "rupiah-payments", "method": "ConvertToRetail", "cases": ["atomic reserve-to-float conversion", "wholesale bank denied", "insufficient reserve", "same-reference replay", "same-reference payload conflict", "insufficient cross-chaincode endorsement"]},
    {"chaincode": "rupiah-payments", "method": "FundWallet", "cases": ["atomic float-to-wallet funding", "ineligible recipient", "holdings limit", "insufficient float", "same-reference replay", "same-reference payload conflict"]},
    {"chaincode": "rupiah-payments", "method": "GetRetailFloat", "cases": ["float after conversion", "float after wallet funding"]},
    {"chaincode": "rupiah-payments", "method": "GetBalance", "cases": ["owner read", "business representative read", "unauthorized subject read", "active and restricted state"]},
    {"chaincode": "rupiah-payments", "method": "GetReceipt", "cases": ["transfer receipt", "funding receipt", "unknown reference", "unrelated caller read behavior"]}
