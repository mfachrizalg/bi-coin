  "correctness_scenarios": [
    {"id":"kyc-risk-pep","executor":"ledger-smoke","assertion":"risk and PEP review decisions preserve the intended subject state"},
    {"id":"staff-separation","executor":"ledger-smoke","assertion":"reviewer and senior actions require distinct protected staff identities"},
    {"id":"business-authority","executor":"ledger-smoke","assertion":"representative allowlists and replacement revoke old authority"},
    {"id":"restriction-reasons","executor":"ledger-smoke","assertion":"DTTOT, authority-order, and internal-review restrictions are enforced"},
    {"id":"fresh-release-evidence","executor":"ledger-smoke","assertion":"a new restriction clears old release evidence and requires a new review request"},
    {"id":"authorization-endorsement","executor":"ledger-smoke","assertion":"MSP and endorsement boundaries reject unauthorized writes"},
    {"id":"transaction-limits","executor":"ledger-smoke","assertion":"per-transaction, cumulative, and holdings limits reject excess without state changes"},
    {"id":"transfer-category-matrix","executor":"ledger-smoke","assertion":"all nine sender and receiver category pairs preserve balances"},
    {"id":"transfer-replay-conflict","executor":"ledger-smoke","assertion":"transfer replay is idempotent and payload conflicts do not mutate state"},
    {"id":"conversion-replay-conflict","executor":"ledger-smoke","assertion":"conversion and wallet funding replays are idempotent and payload conflicts do not mutate state"},
    {"id":"conversion-insufficient-reserve","executor":"ledger-smoke","assertion":"conversion rejects insufficient reserve without changing reserve or float"},
    {"id":"wallet-funding-holdings-limit","executor":"ledger-smoke","assertion":"wallet funding enforces the holdings limit without partial credit or float debit"},
    {"id":"conversion-failure-atomicity","executor":"ledger-smoke","assertion":"cross-chaincode endorsement failure leaves wallet, float, and reserve unchanged"},
    {"id":"redemption-replay-conflict","executor":"ledger-smoke","assertion":"redemption replay is idempotent and reference payload conflicts do not mutate state"},
    {"id":"redemption-conservation","executor":"ledger-smoke","assertion":"redemption reserve, wholesale supply, and total supply invariants hold, with total equal to wholesale plus retail"},
    {"id":"msp-read-authorization","executor":"ledger-smoke","assertion":"four MSP read permissions and unrelated receipt access are checked"},
    {"id":"initialization-and-nested-debit","executor":"ledger-smoke","assertion":"initialization is idempotent and internal reserve debit is callable only through conversion"},
    {"id":"insufficient-reserve","executor":"ledger-smoke","assertion":"interbank transfer rejects insufficient source reserve without changing either reserve"},
    {"id":"insufficient-float","executor":"ledger-smoke","assertion":"wallet funding rejects insufficient float without changing float or wallet"},
    {"id":"cross-bank-debit-denied","executor":"ledger-smoke","assertion":"a bank identity cannot debit another bank's reserve"},
    {"id":"wholesale-conversion-denied","executor":"ledger-smoke","assertion":"a wholesale bank cannot convert reserve to retail float"},
    {"id":"api-route-authorization-matrix","executor":"api-access-matrix","assertion":"every route and application-role cell reaches or is denied at the expected authorization boundary"},
    {"id":"api-request-validation-matrix","executor":"api-access-matrix","assertion":"permitted mutation routes reject malformed requests at validation before ledger effects"},
    {"id":"api-route-action-outcomes","executor":"api-access-matrix","assertion":"bodyless API actions succeed or produce a verified expected denial with unchanged ledger state"}
  ]
}
