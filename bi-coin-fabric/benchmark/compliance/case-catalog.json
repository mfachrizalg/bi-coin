    {"chaincode": "rupiah-controls", "method": "ApproveUnfreeze", "cases": ["distinct senior after reviewer request", "senior before reviewer request", "same reviewer and senior", "new different-reason restriction requires new request", "new same-reason restriction requires new request", "same digest with a new reviewer request"]},
    {"chaincode": "rupiah-controls", "method": "GetCallerIdentity", "cases": ["identity from each MSP", "distinct user certificates"]},
