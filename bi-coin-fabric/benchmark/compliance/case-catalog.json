  "protocol": {
    "worker_count": 1,
    "measurement_mode": "binary-search-and-confirmation",
    "minimum_rate_ops_per_second": 0.1,
    "maximum_rate_ops_per_second": 4096,
    "initial_rate_ops_per_second": 32,
    "unbounded_rate_expansion_factor": 4,
    "probe_duration_seconds": 10,
    "boundary_tolerance_percent": 10,
    "confirmation_repetitions": 3,
    "confirmation_duration_seconds": 30,
    "delivered_load_tolerance_percent": 5,
    "drain_adjusted_throughput_floor": 0.9,
    "resource_sample_interval_ms": 1000,
    "performance_method_count": 33,
    "performance_workload_count": 34,
    "search_hint_source": "compliance-20261010-controls-v16 direct-ledger sweep; hints only",
    "search_hints_ops_per_second": {
      "create-pending": 64,
      "record-review": 32,
      "approve-standard": 32,
      "decide-high-risk": 32,
      "open-wallet": 128,
      "freeze-subject": 32,
      "request-unfreeze": 32,
      "approve-unfreeze": 32,
      "issue": 32,
      "redeem-reserve": 32
