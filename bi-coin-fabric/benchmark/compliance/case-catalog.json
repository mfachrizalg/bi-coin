    {"chaincode": "rupiah-controls", "method": "ProtectStaff", "cases": ["protect pending staff", "unknown staff", "wrong MSP", "missing effective-control endorsement"]},
    {"chaincode": "rupiah-controls", "method": "SetStaffRole", "cases": ["assign reviewer", "assign senior approver", "assign compliance officer", "replace existing role", "unknown role", "unprotected staff"]},
