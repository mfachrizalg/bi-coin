@startuml controls-study-use-case
title Use Case Diagram Ruang Kerja per Organisasi
left to right direction
skinparam monochrome true
skinparam dpi 300
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "EndUserMSP\nPengguna" as EndUser
actor "DistributorMSP\nOperator" as Distributor
actor "CentralBankMSP\nOperator" as CentralBank
actor "Auditor (OJK, PPATK)\nValidatorMSP" as Validator
actor "KYC Reviewer" as KycReviewer
actor "Compliance Officer" as ComplianceOfficer

rectangle "Ruang kerja masing-masing organisasi\nkanal bi-coin" {
  usecase "Pendaftaran subjek, dompet,\nsaldo, dan transfer" as EndUserUC
  usecase "Peninjauan subjek, keputusan CDD Sederhana,\nverifikasi, pembaruan, penutupan,\ndan pendanaan cadangan" as DistributorUC
  usecase "Pembatasan, pembukaan pembatasan,\ndan pencabutan status risiko rendah" as RestrictionUC
  usecase "Peninjauan peringatan pemantauan\ndan draf LTKM" as MonitoringUC
  usecase "Pengelolaan staf, operasi moneter,\nalokasi cadangan, dan plafon CDD" as CentralBankUC
  usecase "Audit kontrol\nbaca-saja" as ValidatorUC
}

EndUser -- EndUserUC
Distributor -- DistributorUC
CentralBank -- CentralBankUC
Validator -- ValidatorUC
KycReviewer -- DistributorUC
KycReviewer -- RestrictionUC
ComplianceOfficer -- RestrictionUC
ComplianceOfficer -- MonitoringUC

@enduml
