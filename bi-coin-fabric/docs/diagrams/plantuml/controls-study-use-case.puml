@startuml controls-study-use-case
title Use Case Diagram Ruang Kerja per Organisasi
left to right direction
skinparam monochrome true
skinparam dpi 300
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "EndUserMSP\nPengguna" as EndUser
actor "DistributorMSP\nOperator" as Distributor
actor "CentralBankMSP\nOperator" as CentralBank
actor "Observer/Auditor (OJK, PPATK)\nValidatorMSP" as Validator
actor "KYC Reviewer" as KycReviewer
actor "Senior Approver" as SeniorApprover
actor "Compliance Officer" as ComplianceOfficer

rectangle "Ruang kerja masing-masing organisasi\nkanal bi-coin" {
  usecase "Pendaftaran subjek, dompet,\nsaldo, dan transfer" as EndUserUC
  usecase "Persetujuan subjek, kewenangan usaha,\ndan pendanaan cadangan" as DistributorUC
  usecase "Pembatasan dan pembukaan\npembatasan subjek" as RestrictionUC
  usecase "Pengelolaan staf, operasi moneter,\ndan alokasi cadangan" as CentralBankUC
  usecase "Audit kontrol\nbaca-saja" as ValidatorUC
}

EndUser -- EndUserUC
Distributor -- DistributorUC
CentralBank -- CentralBankUC
Validator -- ValidatorUC
KycReviewer -- DistributorUC
SeniorApprover -- DistributorUC
KycReviewer -- RestrictionUC
SeniorApprover -- RestrictionUC
ComplianceOfficer -- RestrictionUC

@enduml
