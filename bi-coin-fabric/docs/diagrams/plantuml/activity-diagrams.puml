  :Kirim error;
  end
else (ya)
endif

|Blockchain|
:FreezeParticipant()
Ubah status peserta ke frozen;
:Freeze wallet terkait (cascade);
:Catat supervision event
participant_frozen;

if (Akan di-unfreeze?) then (tidak)
  end
else (ya)
endif

