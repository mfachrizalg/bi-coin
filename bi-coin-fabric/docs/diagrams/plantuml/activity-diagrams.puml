skinparam activityBackgroundColor white
skinparam activityBorderColor black
skinparam activityDiamondBackgroundColor white
skinparam activityDiamondBorderColor black
skinparam arrowColor black
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam swimlaneBorderColor black
skinparam partitionBorderColor black

title Pendaftaran Peserta

|Bank/PJP|
start
:Kirim data pendaftaran peserta;

|Backend API|
:POST /participants;
:Validasi peran dan data pendaftaran;
if (Data valid?) then (tidak)
  :Kirim error validasi;
  end
else (ya)
endif

|Blockchain|
:SubmitParticipant()
status = pending;

|Bank Indonesia|
:Tinjau pengajuan peserta;
if (Pengajuan disetujui?) then (ya)
  |Backend API|
  :POST /participants/{id}/approve;
  |Blockchain|
  :ApproveParticipant()
  status = active;
  :Buat dompet peserta;
else (tidak)
  |Backend API|
  :POST /participants/{id}/reject;
  |Blockchain|
  :RejectParticipant()
  status = rejected;
endif

|Backend API|
:Kirim hasil pendaftaran;
stop
@enduml

