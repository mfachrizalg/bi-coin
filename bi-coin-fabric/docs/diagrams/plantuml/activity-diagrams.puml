@startuml AD08-Pembekuan-Peserta
skinparam monochrome true
skinparam defaultFontSize 11
skinparam activityFontSize 11
skinparam activityBackgroundColor white
skinparam activityBorderColor black
skinparam activityDiamondBackgroundColor white
skinparam activityDiamondBorderColor black
skinparam arrowColor black
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam swimlaneBorderColor black
skinparam partitionBorderColor black

title Pembatasan dan Pembukaan Pembatasan Peserta

|Staf Distributor|
start
:Compliance Officer menginisiasi pembatasan peserta;

|Backend API|
:POST /subjects/{subject_id}/restrictions;
:Validasi peran Distributor;

if (Otorisasi valid?) then (tidak)
  :Kirim error;
  end
else (ya)
endif

|Blockchain|
:FreezeSubject() ubah status peserta ke dibatasi;
:Batasi subjek (transfer ditolak selama pembatasan);
:Catat pembatasan subjek;

if (Akan dibuka pembatasannya?) then (tidak)
  end
else (ya)
endif

|Staf Distributor|
:KYC Reviewer mengajukan permintaan pembukaan pembatasan;

|Backend API|
:POST /subjects/{subject_id}/restriction-release-requests;

|Blockchain|
:RequestUnfreeze() catat reviewer dan referensi bukti;

|Staf Distributor|
:Senior Approver menyetujui pembukaan pembatasan;

|Backend API|
:POST /subjects/{subject_id}/restriction-release-decisions;

|Blockchain|
:ApproveUnfreeze()
status kembali ke active;
:Buka pembatasan subjek;
:Catat pembukaan pembatasan subjek;
end

@enduml

