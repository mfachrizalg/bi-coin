skinparam partitionBorderColor black

title Transfer Antarbank, Konversi, dan Pendanaan Dompet

|Distributor Bank|
start
:Inisiasi transfer antarbank;

|Backend API|
:Terima request transfer (POST /interbank-transfers);
:Validasi peran Distributor Bank;
if (Peran valid?) then (tidak)
  :Kirim error 403;
  end
else (ya)
endif

|Blockchain|
:TransferReserve() validasi nominal dan atribut pengirim;
if (Saldo reserve cukup?) then (tidak)
  :Tolak transfer;
  end
else (ya)
endif
:Kurangi reserve pengirim, tambah reserve penerima;
:Catat transaksi transfer;

|Backend API|
:Kirim konfirmasi transfer;

|Retail Bank|
:Inisiasi konversi ke r-Rupiah Digital;

|Backend API|
:Terima request konversi (POST /conversions);
:Validasi peran Retail Bank;
if (Peran valid?) then (tidak)
  :Kirim error 403;
  end
else (ya)
endif

|Blockchain|
:ConvertToRetail() validasi atribut dan kind retail;
if (Saldo reserve cukup?) then (tidak)
  :Tolak konversi;
  end
else (ya)
endif
:Debit reserve w-Rupiah Digital, kredit float r-Rupiah Digital;
:Catat transaksi konversi;

|Backend API|
:Kirim konfirmasi konversi;

|Retail Bank|
:Inisiasi pendanaan dompet pelanggan;

|Backend API|
:Terima request pendanaan (POST /wallet-fundings);
:Validasi peran Retail Bank;
if (Peran valid?) then (tidak)
  :Kirim error 403;
  end
else (ya)
endif

|Blockchain|
:FundWallet() validasi kelayakan dan limit;
if (Subjek layak dan dalam limit?) then (tidak)
  :Tolak pendanaan;
  end
else (ya)
endif
:Debit float r-Rupiah Digital, kredit dompet pelanggan;
:Catat transaksi pendanaan;

|Backend API|
:Kirim konfirmasi pendanaan;
stop
@enduml

