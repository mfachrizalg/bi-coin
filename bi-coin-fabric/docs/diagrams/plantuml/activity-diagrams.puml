@startuml AD01-Pendaftaran-Peserta
skinparam monochrome true
skinparam defaultFontSize 11
skinparam activityFontSize 11
skinparam activityBackgroundColor white
skinparam activityBorderColor black
skinparam activityDiamondBackgroundColor white
skinparam activityDiamondBorderColor black
skinparam arrowColor black
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam swimlaneBorderColor black
skinparam partitionBorderColor black

title Pendaftaran Peserta

|Distributor Bank|
start
:Kirim data pendaftaran peserta;

|Backend API|
:POST /subjects;
:Validasi peran dan data pendaftaran;
if (Data valid?) then (tidak)
  :Kirim error validasi;
  end
else (ya)
endif

|Blockchain|
:CreatePending()
status = pending;

|Staf Distributor|
:Tinjau pengajuan peserta;
if (Pengajuan disetujui?) then (ya)
  |Backend API|
  :POST /subjects/{subject_id}/decisions;
  |Blockchain|
  :ApproveStandard() / DecideHighRisk()
  status = active;
else (tidak)
  |Backend API|
  :POST /subjects/{subject_id}/decisions;
  |Blockchain|
  :ApproveStandard() / DecideHighRisk()
  status = rejected;
endif

|Backend API|
:Kirim hasil pendaftaran;
stop
@enduml

