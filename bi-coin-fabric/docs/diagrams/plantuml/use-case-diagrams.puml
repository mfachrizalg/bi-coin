@startuml
skinparam monochrome true
left to right direction
skinparam packageBorderColor black
skinparam packageBackgroundColor none
skinparam usecaseBorderColor black
skinparam usecaseBackgroundColor white
skinparam actorBorderColor black
skinparam actorBackgroundColor white
skinparam arrowColor black

title <<UC01>> Sistem Keseluruhan (Overall System)

left to right direction

actor "Bank Indonesia" as BI
actor "Distributor Bank" as DB
actor "Merchant" as M
actor "Pelanggan\nRitel" as PR
actor "Observer/Auditor\n(OJK, PPATK)" as OBS
actor "KYC Reviewer" as KYC
actor "Senior Approver" as SA
actor "Compliance Officer" as CO

rectangle "Sistem bi-coin-fabric" {
  usecase "Mendaftarkan\nPeserta" as UC1
  usecase "Menerbitkan\nw-Rupiah Digital" as UC2
  usecase "Mentransfer\nAntarbank" as UC3
  usecase "Mengelola KYC\nPelanggan" as UC4
  usecase "Mentransfer\nSaldo" as UC5
  usecase "Transfer ke\nPedagang" as UC6
  usecase "Membatasi/Membuka\nPembatasan Peserta" as UC8
  usecase "Membaca\nStatus Subjek" as UC10
}

BI --> UC1
BI --> UC2
DB --> UC3
DB --> UC1
DB --> UC4
M --> UC6
PR --> UC5
PR --> UC6
OBS --> UC10
KYC --> UC4
SA --> UC4
KYC --> UC8
SA --> UC8
CO --> UC8

UC1 ..> UC4 : <<include>>
UC8 ..> UC1 : <<extend>>

@enduml

@startuml
skinparam monochrome true
left to right direction
skinparam packageBorderColor black
skinparam packageBackgroundColor none
skinparam usecaseBorderColor black
skinparam usecaseBackgroundColor white
skinparam actorBorderColor black
skinparam actorBackgroundColor white
skinparam arrowColor black

title <<UC02>> Operasi Institusional (Institutional Operations)

actor "Bank Indonesia" as BI
actor "Distributor Bank" as DB
actor "Retail Bank" as RB
actor "Observer/Auditor\n(OJK, PPATK)" as OBS

rectangle "Operasi Institusional" {
  usecase "Menerbitkan dan Menebus\nw-Rupiah Digital" as UC1
  usecase "Mentransfer\nAntarbank" as UC2
  usecase "Mengelola Siklus\nHidup Peserta" as UC3
  usecase "Mengelola\nKebijakan Limit" as UC4
  usecase "Membaca\nStatus Subjek" as UC6
  usecase "Mengonversi ke\nr-Rupiah Digital" as UC7
  usecase "Mendanai Dompet\nPelanggan" as UC8
}

BI --> UC1
BI --> UC3
BI --> UC4
BI --> UC6
DB --> UC2
DB --> UC3
RB --> UC2
RB --> UC7
RB --> UC8
OBS --> UC6

@enduml

@startuml
skinparam monochrome true
left to right direction
skinparam packageBorderColor black
skinparam packageBackgroundColor none
skinparam usecaseBorderColor black
skinparam usecaseBackgroundColor white
skinparam actorBorderColor black
skinparam actorBackgroundColor white
skinparam arrowColor black

title <<UC03>> Operasi Retail (Retail Operations)

actor "Pelanggan\nRitel" as PR
actor "Merchant" as M
actor "KYC Reviewer" as KYC
actor "Senior Approver" as SA
actor "Compliance Officer" as CO

rectangle "Operasi Retail" {
  usecase "Registrasi KYC" as UC1
  usecase "Mentransfer Saldo" as UC2
  usecase "Transfer\nAntarpelanggan" as UC3
  usecase "Transfer ke Pedagang" as UC4
}

PR --> UC1
PR --> UC2
PR --> UC4
M --> UC3
KYC --> UC1
SA --> UC1

UC4 ..> UC3 : <<include>>

@enduml
